{
  "name": "affiliate-os",
  "version": "0.1.0",
  "private": true,
  "description": "Affiliate OS v1.0 — Modular SaaS Operating System for affiliate intelligence, content operations, performance optimization, revenue intelligence, automation, billing, and ecosystem commerce.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:architecture": "vitest run tests/architecture",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:status": "node scripts/migrate.mjs status",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
