# ==============================================================
# AFFILIATE OS v1.0 — ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================
# Copy to `.env` (local Node tooling, e.g. migrations) and/or
# `.dev.vars` (local Cloudflare Workers runtime).
#
# NEVER commit `.env` or `.dev.vars`.
# NEVER put real credentials in this file.
# All values below are PLACEHOLDERS.
# ==============================================================

# ── CORE APPLICATION ──────────────────────────────────────────
# NODE_ENV: development | test | staging | production
NODE_ENV=development
APP_NAME=affiliate-os
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
LOG_LEVEL=debug

# ── DATABASE (PostgreSQL — DOC 21 / DOC 24 baseline) ──────────
# Production target is PostgreSQL. SQLite / in-memory / JSON files
# are FORBIDDEN as the production database (Task 01 §11).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/affiliate_os
DATABASE_SSL=false
# Optional: Cloudflare Hyperdrive binding id when running on Workers.
# HYPERDRIVE_ID=

# ── AUTHENTICATION (Module 15 — implemented in a later task) ──
# Generate locally with: openssl rand -base64 48
AUTH_SECRET=replace-with-locally-generated-secret
SESSION_COOKIE_NAME=aos_session
SESSION_TTL_SECONDS=86400

# ── PENDING / FUTURE PROVIDERS ────────────────────────────────
# Declared for documentation only. NOT implemented in Task 01.

# Billing provider — Duitku (DOC 25). PENDING.
# DUITKU_MERCHANT_CODE=
# DUITKU_API_KEY=
# DUITKU_ENVIRONMENT=sandbox

# Platform connectors (DOC 17 / Module 17). PENDING.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Object storage, S3-compatible (DOC 24). PENDING.
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Queue, Redis-compatible (DOC 24). PENDING.
# QUEUE_URL=

# ── DEPLOYMENT (provided by CI/secure environment ONLY) ───────
# NEVER store these in the repository.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
