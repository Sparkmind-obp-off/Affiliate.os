# Local Cloudflare Workers runtime variables.
# Copy to `.dev.vars` (git-ignored). Placeholders only — never real secrets.

NODE_ENV=development
LOG_LEVEL=debug
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1

# PostgreSQL. See docs/ARCHITECTURE-CONFLICTS.md (CONFLICT-01) — reaching
# PostgreSQL from a Worker requires Hyperdrive or an HTTP driver.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/affiliate_os

# Generate locally: openssl rand -base64 48
# AUTH_SECRET=
